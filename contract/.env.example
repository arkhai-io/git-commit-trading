# Environment variables for contract deployment
# Copy this file to .env and fill in your values

# Your private key (with or without 0x prefix)
# Examples:
# PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# OR
# PRIVATE_KEY=ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=your_private_key_here

# Sepolia RPC URL (get from Infura, Alchemy, or other provider)
SEPOLIA_RPC_URL=your_rpc_url_here

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: Gas price settings (in gwei)
# GAS_PRICE=20

# Optional: Gas limit for deployment
# GAS_LIMIT=3000000