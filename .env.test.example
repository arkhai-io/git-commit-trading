# Test environment configuration for full-flow integration tests
# Copy this file to .env.test and update the paths as needed

# Path to your SSH private key (ed25519 format required)
# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/git-alkahest/id_ed25519 -N "" -C "test@example.com"
TEST_SSH_PRIVATE_KEY_PATH=~/.ssh/git-alkahest/id_ed25519

# Path to your SSH public key
TEST_SSH_PUBLIC_KEY_PATH=~/.ssh/git-alkahest/id_ed25519.pub
