# Test Verification Environment Configuration
# This file contains keys and configuration for running SSH and PGP verification tests

# ============================================
# TEST ENVIRONMENT SETTINGS
# ============================================
TEST_CLEANUP=true
TEST_TIMEOUT=30000
TEST_TEMP_DIRECTORY=/tmp/git-escrow-tests

# ============================================
# SSH KEY TEST CONFIGURATIONS
# ============================================

# Valid SSH Ed25519 public key for testing import and verification
SSH_VALID_ED25519_PUBLIC_KEY=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGrTzJn2l8vF9HJ3q5J5K4Y7X8Z9A1B2C3D4E5F6G7H8I9J0 test@example.com
SSH_VALID_ED25519_ETHEREUM_ADDRESS=0x1234567890123456789012345678901234567890
SSH_VALID_ED25519_KEY_TYPE=SSHEd25519

# Valid SSH RSA public key for testing RSA key support
SSH_VALID_RSA_PUBLIC_KEY=ssh-rsa  test-rsa@example.com
SSH_VALID_RSA_ETHEREUM_ADDRESS=0x2345678901234567890123456789012345678901
SSH_VALID_RSA_KEY_TYPE=SSHSecp256k1

# Invalid SSH key format for testing error handling
SSH_INVALID_PUBLIC_KEY=invalid-ssh-key-format
SSH_INVALID_ETHEREUM_ADDRESS=0x3456789012345678901234567890123456789012
SSH_INVALID_KEY_TYPE=SSHEd25519

# ============================================
# PGP KEY TEST CONFIGURATIONS
# ============================================

# Valid PGP public key in ASCII-armored format for testing
# Replace with a real PGP public key before running tests
PGP_VALID_PUBLIC_KEY="-----BEGIN PGP PUBLIC KEY BLOCK-----

REPLACE_WITH_REAL_PGP_PUBLIC_KEY_CONTENT

-----END PGP PUBLIC KEY BLOCK-----"
PGP_VALID_KEY_ID=0x1234567890ABCDEF
PGP_VALID_FINGERPRINT=1234567890123456789012345678901234567890
PGP_VALID_ETHEREUM_ADDRESS=0x4567890123456789012345678901234567890123
PGP_VALID_KEY_TYPE=PGPv4
PGP_VALID_USER_ID="Test User <test-pgp@example.com>"

# Expired PGP key for testing expiration handling
# Replace with a real expired PGP public key before running tests
PGP_EXPIRED_PUBLIC_KEY="-----BEGIN PGP PUBLIC KEY BLOCK-----

REPLACE_WITH_REAL_EXPIRED_PGP_PUBLIC_KEY_CONTENT

-----END PGP PUBLIC KEY BLOCK-----"
PGP_EXPIRED_KEY_ID=0xDEADBEEF12345678
PGP_EXPIRED_FINGERPRINT=DEADBEEF123456789012345678901234567890
PGP_EXPIRED_ETHEREUM_ADDRESS=0x5678901234567890123456789012345678901234
PGP_EXPIRED_KEY_TYPE=PGPv4
PGP_EXPIRED_USER_ID="Expired User <expired@example.com>"

# Invalid PGP key format for testing error handling
PGP_INVALID_PUBLIC_KEY="-----BEGIN INVALID KEY-----
This is not a valid PGP key
-----END INVALID KEY-----"
PGP_INVALID_ETHEREUM_ADDRESS=0x6789012345678901234567890123456789012345
PGP_INVALID_KEY_TYPE=PGPv4

# ============================================
# SERVER CONFIGURATION
# ============================================
SERVER_AUTO_IMPORT_KEYS=true
SERVER_ENABLE_SSH=true
SERVER_ENABLE_GPG=true
SERVER_ENABLE_X509=false
SERVER_CLEANUP_AFTER_TEST=true
SERVER_TIMEOUT_MS=30000

# ============================================
# PGP TEST EXECUTION CONFIGURATIONS
# ============================================

# Repository for testing PGP signature verification during test execution
PGP_TEST_REPO_URL=REPLACE_WITH_REAL_REPO_URL
PGP_TEST_COMMIT_HASH=REPLACE_WITH_REAL_COMMIT_HASH

# Testcase repository (can be same as test repo)
PGP_TESTCASE_REPO_URL=REPLACE_WITH_REAL_TESTCASE_REPO_URL
PGP_TESTCASE_COMMIT_HASH=REPLACE_WITH_REAL_TESTCASE_COMMIT_HASH

# Repository with invalid/missing PGP signature for negative testing
PGP_INVALID_REPO_URL=REPLACE_WITH_REPO_WITHOUT_PGP_SIGNATURE
PGP_INVALID_COMMIT_HASH=REPLACE_WITH_UNSIGNED_COMMIT_HASH

# Test execution timeout (milliseconds)
PGP_TEST_TIMEOUT=60000

# Optional: Contract address for blockchain integration testing
PGP_CONTRACT_ADDRESS=REPLACE_WITH_CONTRACT_ADDRESS_IF_TESTING_BLOCKCHAIN

# ============================================
# INSTRUCTIONS
# ============================================
# To use this configuration:
# 1. Replace PGP_VALID_PUBLIC_KEY with a real PGP public key
# 2. Replace PGP_EXPIRED_PUBLIC_KEY with a real expired PGP public key
# 3. Update the corresponding key IDs and fingerprints
# 4. Fill in PGP_TEST_REPO_URL and related test execution fields
# 5. Run the tests: bun test tests/sshVerify.test.ts tests/pgpVerify.test.ts tests/pgpTestExecution.test.ts