# Server/Submitter/Fulfiller ENV example file
# Required: Your private key (64 hex characters starting with 0x)
PRIVATE_KEY=0xPrivateKey
# PRIVATE_KEY=0xa161f26c2b4e0fdec87756388cbfd97ef41ac846520cf1158fd4a92d2e3c9634

# Required: Your Ethereum address (should match the private key)
ADDRESS=0xAddr
# ADDRESS=0x9774A7c694198A46Ce9e360c4BD619641d32e2A6

# Required: Network to connect to
NETWORK=base-sepolia

# Optional: RPC URL (defaults to http://127.0.0.1:8545 for anvil/localhost)
RPC_URL=https://base-sepolia.infura.io
WS_RPC_URL=wss://base-sepolia.infura.io
DEBUG=true
# Required for most commands: Contract addresses
# You need to deploy these contracts or get the addresses from someone who has
COMMIT_OBLIGATION_ADDRESS=0x039336222fcec75041C8fE6c372997AF107e0d16
GIT_IDENTITY_REGISTRY_ADDRESS=0x199017039dcBAa45eDcABF761054f616ED6de654

# Required for list command: ERC20 Escrow contract that holds the tokens
ERC20_ESCROW_OBLIGATION_ADDRESS=0x3826430c1C358623a76e7E240f186D8ad0aEc1d1

# Arbiter contract address (TrustedOracleArbiter)
ARBITER_ADDRESS=0xC343eA368bb7c4a54c92a1aB4d46Db38D7CCaf39
# ORACLE_ADDRESS=0x...
#### TOKEN ADDRESS
# -> USDC Token on Base Sepolia
# TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
