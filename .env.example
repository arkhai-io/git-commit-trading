# Git Escrows Client Configuration
# Copy this file to .env and fill in your values

# Required: Your private key (64 hex characters starting with 0x)
# Address is derived automatically from the private key
PRIVATE_KEY=

# Required: Network to connect to
NETWORK=anvil

# Optional: RPC URL (defaults to http://127.0.0.1:8545 for anvil)
RPC_URL=https://base-sepolia.infura.io
WS_RPC_URL=wss://base-sepolia.infura.io
DEBUG=true
# Required for most commands: Contract addresses
# You need to deploy these contracts or get the addresses from someone who has
COMMIT_OBLIGATION_ADDRESS=0x03d2591DfDf75611AdE94A9a80af61F9BcBfc4e2
GIT_IDENTITY_REGISTRY_ADDRESS=0xc6b3fA56853F7D5abdFdaa7d008d9c27eBdE3e8a

ORACLE_ADDRESS=0x84Fa6d4087B267e2D1B158Ffa277338Da725746b
# TOKEN_ADDRESS=0x...

# Example values above are from Anvil's default accounts
# Replace with your actual values before using
