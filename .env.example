# Git Escrows Client Configuration
# Copy this file to .env and fill in your values

# Required: Your private key (64 hex characters starting with 0x)
PRIVATE_KEY=

# Required: Your Ethereum address (should match the private key)
ADDRESS=

# Required: Network to connect to
NETWORK=anvil

# Optional: RPC URL (defaults to http://127.0.0.1:8545 for anvil/localhost)
RPC_URL=http://127.0.0.1:8545

# Required for most commands: CommitObligation contract address
# You need to deploy this contract or get the address from someone who has
COMMIT_OBLIGATION_ADDRESS=

# Optional additional contract addresses (used by some commands):
# ERC20_ESCROW_OBLIGATION_ADDRESS=0x...
# ARBITER_ADDRESS=0x...
# ORACLE_ADDRESS=0x...
# TOKEN_ADDRESS=0x...

# Example values above are from Anvil's default accounts
# Replace with your actual values before using
